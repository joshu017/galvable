{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retrometer",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "retrometer.online",
      "custom_domain": true
    },
    {
      "pattern": "www.retrometer.online",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
